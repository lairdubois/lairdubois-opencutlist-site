<header class="bg-ink text-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-3 flex items-center gap-6">
    <%= link_to home_path, class: "flex items-center gap-3 mr-auto" do %>
      <%= image_tag "ocl-icon.svg", alt: "", class: "size-9 sm:size-10" %>
      <span class="font-mono font-bold text-lg sm:text-xl tracking-wide">OpenCutList</span>
    <% end %>
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
      <%= render "layouts/nav_links" %>
      <%= external_link_to t("nav.docs"), Site.link(:docs), class: "px-2.5 py-1 hover:bg-white/10 transition-colors" %>
    </nav>
    <% alternate_locales.each do |locale| %>
      <%= link_to locale.to_s.upcase, url_for(locale:), hreflang: locale, lang: locale, title: t("nav.language", locale:),
                  class: "label text-xs border border-white/40 px-1.5 py-0.5 hover:border-brand hover:text-brand" %>
    <% end %>
  </div>
  <%# Phones : the pages and the documentation on their own row %>
  <nav class="md:hidden border-t border-white/10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-2 flex items-center justify-between gap-1 -mx-2 sm:mx-auto text-[0.8125rem] sm:text-sm font-medium">
      <%= render "layouts/nav_links" %>
      <%= external_link_to t("nav.docs_short"), Site.link(:docs), title: t("nav.docs"), class: "px-2 sm:px-2.5 py-1 whitespace-nowrap hover:bg-white/10 transition-colors" %>
    </div>
  </nav>
</header>
