<% content_for :title, "OpenCutList #{Site.lab.version} LAB" %>
<% content_for :description, t("lab.description") %>

<section class="bg-brand text-ink">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-20">
    <p class="text-sm flex items-center gap-3"><%= brand("OpenCutList #{Site.lab.version}") %> <span class="lab-pill">LAB</span></p>
    <h1 class="display display-1 text-white mt-4 max-w-4xl"><%= t("home.lab.title") %></h1>
    <p class="mt-6 text-lg sm:text-xl max-w-2xl font-medium"><%= t("lab.intro") %></p>
    <div class="mt-6 max-w-2xl border-l-4 border-ink pl-4">
      <p class="font-bold"><%= t("lab.notice.title") %></p>
      <p class="mt-1"><%= t("lab.notice.text") %></p>
    </div>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <%= link_to Site.lab.url, class: "btn btn-ink", download: true do %>
        <span><%= brand(t("download.lab.button", version: Site.lab.version)) %> <span class="lab-pill text-[0.8em]">LAB</span></span>
        <small><%= [ t("download.lab.detail"), Site.lab.build ].compact.join(" · ") %></small>
      <% end %>
      <a href="#install" class="link font-semibold"><%= t("lab.install.link") %></a>
    </div>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 sm:px-6 py-16 grid gap-12 md:grid-cols-2">
  <div>
    <h2 class="display display-3"><%= t("lab.new.title", version: Site.lab.version) %></h2>
    <ul class="mt-6 space-y-4">
      <% t("lab.new.items").each do |item| %>
        <li class="border-l-4 border-brand pl-4">
          <p class="font-bold"><%= item[:title] %></p>
          <p class="text-ink-soft"><%= item[:text] %></p>
        </li>
      <% end %>
    </ul>
  </div>

  <div id="install" class="scroll-mt-6">
    <h2 class="display display-3"><%= t("lab.install.title") %></h2>
    <ol class="mt-6 space-y-4">
      <% t("lab.install.steps").each_with_index do |step, index| %>
        <li class="flex gap-4">
          <span class="text-sm bg-ink text-white size-8 shrink-0 grid place-items-center"><%= index + 1 %></span>
          <p class="pt-1"><%= step %></p>
        </li>
      <% end %>
    </ol>
    <div class="mt-8 bg-white p-5 border-l-4 border-lab">
      <p class="font-bold"><%= t("lab.back.title", version: Site.stable.version) %></p>
      <p class="mt-1 text-ink-soft">
        <%= t("lab.back.text_html", version: Site.stable.version,
                                    warehouse: external_link_to("Extension Warehouse", Site.stable.url, class: "link")) %>
      </p>
    </div>
    <% if Site.lab.changelog_url %>
      <p class="mt-4"><%= external_link_to t("lab.changelog"), Site.lab.changelog_url, class: "link font-semibold" %></p>
    <% end %>
  </div>
</section>

<section class="bg-ink text-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 grid gap-12 md:grid-cols-2">
    <div>
      <h2 class="display display-3 text-brand"><%= t("lab.feedback.title") %></h2>
      <p class="mt-4 text-lg text-white/85"><%= t("lab.feedback.text") %></p>
      <ul class="mt-6 space-y-3">
        <% { sketchup_forum: "SketchUp Forum", lairdubois_thread: "L'Air du Bois", open_collective_conversations: "Open Collective", youtube: "YouTube" }.each do |key, name| %>
          <% url = Site.link(key) || (Site.link(:lairdubois) if key == :lairdubois_thread) %>
          <% next unless url %>
          <li>
            <%= external_link_to url, class: "group flex items-baseline gap-3" do %>
              <span class="label text-xs text-brand">→</span>
              <span class="font-bold group-hover:text-brand"><%= name %></span>
              <span class="text-white/60 text-sm"><%= t("lab.feedback.channels.#{key}") %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>

    <div>
      <h2 class="display display-3 text-brand"><%= t("lab.episodes.title") %></h2>
      <p class="mt-4 text-lg text-white/85"><%= t("lab.episodes.text") %></p>
      <ol class="mt-6 divide-y divide-white/15 border-y border-white/15">
        <% @episodes.each do |episode| %>
          <li class="py-3 flex items-baseline gap-4">
            <span class="label text-xs text-white/60 w-10 shrink-0"><%= format("%02d", episode.number) %></span>
            <span class="flex-1 font-bold <%= 'text-white/60' unless episode.released? %>"><%= episode.title %></span>
            <% if episode.url %>
              <%= external_link_to t("lab.episodes.watch"), episode.url, class: "label text-xs text-brand hover:text-white" %>
            <% else %>
              <span class="label text-xs text-white/60">
                <%= episode.released? ? l(episode.date, format: :short) : t("lab.episodes.next", date: l(episode.date, format: :short)) %>
              </span>
            <% end %>
          </li>
        <% end %>
      </ol>
    </div>
  </div>
</section>

<%= render "shared/support_band" %>
