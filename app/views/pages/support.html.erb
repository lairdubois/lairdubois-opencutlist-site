<% content_for :title, t("support.title") %>
<% content_for :description, t("support.description") %>

<section class="bg-brand text-ink">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-20">
    <h1 class="display display-1 text-white max-w-4xl"><%= brand(t("support.headline")) %></h1>
    <div class="mt-6 text-lg sm:text-xl max-w-2xl font-medium prose-ocl">
      <% t("support.paragraphs").each do |paragraph| %>
        <p><%= paragraph %></p>
      <% end %>
    </div>
  </div>
</section>

<%= render "shared/support_band" %>

<section class="mx-auto max-w-6xl px-4 sm:px-6 py-16">
  <h2 class="display display-3"><%= t("support.other.title") %></h2>
  <div class="mt-6 grid gap-px bg-ink/15 border border-ink/15 sm:grid-cols-3">
    <% { test: lab_path, translate: Site.link(:translate), share: Site.link(:youtube) || lab_path }.each do |key, url| %>
      <div class="bg-paper p-6 flex flex-col">
        <h3 class="display text-xl"><%= brand(t("support.other.#{key}.title")) %></h3>
        <p class="mt-3 text-ink-soft flex-1"><%= t("support.other.#{key}.text") %></p>
        <% if url.start_with?("http") %>
          <%= external_link_to t("support.other.#{key}.link"), url, class: "mt-4 link font-semibold self-start" %>
        <% else %>
          <%= link_to t("support.other.#{key}.link"), url, class: "mt-4 link font-semibold self-start" %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
