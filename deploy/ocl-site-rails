#!/usr/bin/env bash
# bin/rails as ocl-site with the production environment, e.g. sudo ocl-site-rails console
# (installed in /usr/local/bin by deploy/setup.sh)
set -euo pipefail

home=/var/www/www.opencutlist.org
cd "$home/app"
exec sudo -u ocl-site bash -c '
  set -a; source /etc/ocl-site.env; set +a
  export PATH='"$home"'/.rbenv/versions/4.0.1/bin:$PATH
  exec bin/rails "$@"
' ocl-site-rails "$@"
